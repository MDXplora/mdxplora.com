---
import Logo from './Logo.astro';
import { footer, site } from '../data/site';

const year = new Date().getFullYear();
// Sign in joins the platform's links once the service's address is set.
const columns = footer.map((column) =>
  column.key === 'platform' && site.appUrl
    ? { ...column, links: [...column.links, { label: 'Sign in', href: site.appUrl }] }
    : column,
);
---

<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <Logo />
      <p>{site.tagline}.</p>
    </div>
    {columns.map((column) => (
      <nav aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container">
    <div class="legal">
      <p>
        &copy; {year} {site.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-sunken);
    padding-block: 56px 32px;
    font-size: 0.9375rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 2.5rem;
  }
  .brand p {
    margin-top: 1rem;
    color: var(--fg-muted);
    max-width: 30ch;
  }
  h2 {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--fg);
    margin-bottom: 0.875rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  a {
    color: var(--fg-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--fg);
  }
  .legal {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    color: var(--fg-subtle);
    font-size: 0.875rem;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>

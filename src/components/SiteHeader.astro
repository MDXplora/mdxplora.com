---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="bar container">
    <a href="/" class="home" aria-label="MDXplora home">
      <Logo id="logo-header" />
    </a>

    <nav aria-label="Site" class="links">
      {nav.map((item) => (
        <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <a class="icon-link" href={site.github} aria-label="FastMDXplora on GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
      <a class="button button-primary button-small" href="/docs/installation/">
        Get started
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Site" class="container">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={site.github}>GitHub</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .site-header.scrolled {
    border-bottom-color: var(--border);
  }
  .bar {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .home {
    color: var(--fg);
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1.75rem;
  }
  .links a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--fg);
  }
  .actions {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .icon-link {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-s);
    color: var(--fg-muted);
  }
  .icon-link:hover {
    color: var(--fg);
    background: var(--surface-hover);
  }
  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .menu-toggle span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding-block: 0.75rem 1.25rem;
  }
  .mobile-menu a {
    padding: 0.7rem 0;
    color: var(--fg);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .links,
    .icon-link,
    .button-small {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
</style>

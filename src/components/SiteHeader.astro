---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="bar container">
    <a href="/" class="home" aria-label="MDXplora home">
      <Logo id="logo-header" />
    </a>

    <nav aria-label="Site" class="links">
      {nav.map((item) => (
        <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <ThemeToggle />
      {site.appUrl && (
        <a class="signin" href={site.appUrl}>
          Sign in
        </a>
      )}
      <a class="button button-primary button-small" href="/contact/?topic=early-access">
        Join early access
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Site" class="container">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="/contact/?topic=early-access">Join early access</a>
      {site.appUrl && <a href={site.appUrl}>Sign in</a>}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .site-header.scrolled {
    border-bottom-color: var(--border);
  }
  .bar {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .home {
    color: var(--fg);
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1.75rem;
  }
  .links a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--fg);
  }
  .actions {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .signin {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .signin:hover {
    color: var(--fg);
  }
  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .menu-toggle span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding-block: 0.75rem 1.25rem;
  }
  .mobile-menu a {
    padding: 0.7rem 0;
    color: var(--fg);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .links,
    .signin,
    .button-small {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
</style>

---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="bar container">
    <a href="/" class="home" aria-label="MDXplora home">
      <Logo />
    </a>

    <nav aria-label="Site" class="links">
      {nav.map((item) => (
        <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <ThemeToggle />
      {site.appUrl && (
        <a class="signin" href={site.appUrl}>
          Sign in
        </a>
      )}
      <a class="button button-primary button-small" href="/contact/?topic=early-access">
        Join early access
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Site" class="container">
      {nav.map((item) => (
        <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a href="/contact/?topic=early-access">Join early access</a>
      {site.appUrl && <a href={site.appUrl}>Sign in</a>}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const show = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
  };
  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';
  toggle?.addEventListener('click', () => show(!isOpen()));
  // Escape closes it, back to its button; so does a window grown past the phone layout.
  addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen()) return;
    show(false);
    toggle?.focus();
  });
  matchMedia('(min-width: 861px)').addEventListener('change', (wide) => wide.matches && show(false));
</script>

<style>
  /* Solid, on the page's own ground, with a hairline beneath: what scrolls under it is hidden, not blurred. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .home {
    color: var(--fg);
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1.75rem;
  }
  .links a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.12s ease;
  }
  .links a:hover {
    color: var(--fg);
  }
  .links a[aria-current='page'],
  .mobile-menu a[aria-current='page'] {
    color: var(--link);
  }
  .actions {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .signin {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.12s ease;
  }
  .signin:hover {
    color: var(--fg);
  }
  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .menu-toggle span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.15s ease;
  }
  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding-block: 0.75rem 1.25rem;
  }
  .mobile-menu a {
    padding: 0.7rem 0;
    color: var(--fg);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .links,
    .signin,
    .button-small {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  /* Without JavaScript the buttons cannot work: the links show instead, on a
     line of their own where the bar is narrow. The header is then as tall as
     its rows, so it scrolls away with the page rather than covering it. */
  @media (scripting: none) {
    .menu-toggle {
      display: none;
    }
  }
  @media (scripting: none) and (max-width: 860px) {
    .site-header {
      position: static;
    }
    .bar {
      height: auto;
      min-height: var(--header-height);
      flex-wrap: wrap;
      column-gap: 1rem;
      row-gap: 0.5rem;
      padding-block: 0.75rem;
    }
    .links {
      display: flex;
      flex-wrap: wrap;
      order: 3;
      width: 100%;
      column-gap: 1.25rem;
      row-gap: 0.25rem;
    }
  }
</style>

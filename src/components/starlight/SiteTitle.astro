---
import Logo from '../Logo.astro';
---

<a href="/" class="site-title" aria-label="MDXplora home">
  <Logo id="logo-docs" />
  <span class="section">Docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .section {
    padding-left: 0.6rem;
    border-left: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: 0.95rem;
    font-weight: 500;
  }
</style>

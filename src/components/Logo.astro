---
import { markElements } from '../lib/brand';

interface Props {
  size?: number;
  wordmark?: boolean;
  /** Unique per page, so two logos on one page do not share a gradient id. */
  id?: string;
}
const { size = 28, wordmark = true, id = 'logo-gradient' } = Astro.props;
---

<span class="logo">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
    set:html={markElements({ id })}
  />
  {wordmark && (
    <span class="wordmark">
      MDX<span>plora</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
  }
  svg {
    flex: none;
    border-radius: 8px;
  }
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .wordmark span {
    font-weight: 500;
  }
</style>

---
import { markElements } from '../lib/brand';

interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 24, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
    set:html={markElements({ tile: false, fill: 'currentColor', small: size <= 32 })}
  />
  {wordmark && <span class="wordmark">MDXplora</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
  }
  /* The droplet in the theme's blue, beside the name in the text's colour. */
  svg {
    flex: none;
    color: var(--accent);
  }
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    line-height: 1;
  }
</style>

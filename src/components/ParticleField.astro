---
import { DROPLET } from '../lib/lj-fluid';

// A small Lennard-Jones fluid (src/lib/lj-fluid.ts), integrated live behind the
// hero. Held just below the critical temperature, it forms droplets that grow
// and break up; they are drawn in a second colour so nucleation and growth can
// be seen, and the caption says what it is. It runs only while on screen, at no
// more than 60 frames a second, and shows a still picture instead for reduced
// motion (also when that is turned on while the page is open), Save-Data, or a
// device that cannot keep up. While it moves, a button beside the caption
// pauses it, and the choice is remembered in this browser.
//
// What the hero holds goes in the slot, so the caption follows it in reading
// order.

const caption =
  'A two-dimensional Lennard-Jones fluid, simulated in your browser just below its critical point. ' +
  `Droplets of ${DROPLET} or more atoms are drawn in teal.`;
---

<canvas class="particle-field" aria-hidden="true"></canvas>
<slot />
<div class="container particle-note">
  <p class="particle-caption">{caption}</p>
  <button class="particle-toggle" type="button" hidden>
    Pause animation
  </button>
</div>

<script>
  import { BOND, CUTOFF, DENSITY, DROPLET, LJFluid } from '../lib/lj-fluid';

  type Theme = { particle: string; bond: string };

  const SIGMA_PX = 16; // one sigma on screen
  const MAX_PARTICLES = 1600;
  const SETTLE_STEPS = 300; // enough for the starting lattice to melt
  const FRAME_MS = 1000 / 60; // high refresh rate screens get 60 frames a second, not 120
  const BUDGET_MS = 6; // the most one frame's simulation and drawing may take
  const SLICE_MS = 5; // settling runs in slices this long, so it never blocks the page
  const HELD = 'mdxplora-fluid'; // 'paused' while the visitor has paused it

  const remembered = () => {
    try {
      return localStorage.getItem(HELD) === 'paused';
    } catch {
      return false;
    }
  };
  const remember = (held: boolean) => {
    try {
      if (held) localStorage.setItem(HELD, 'paused');
      else localStorage.removeItem(HELD);
    } catch {}
  };

  function colours(): Theme {
    const style = getComputedStyle(document.documentElement);
    return {
      particle: style.getPropertyValue('--particle').trim() || '143, 176, 255',
      bond: style.getPropertyValue('--bond').trim() || '34, 195, 181',
    };
  }

  // Runs work when the browser is idle, or soon where it cannot say.
  const idle = (work: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(work, { timeout: 200 }) : setTimeout(work, 16);

  function start(canvas: HTMLCanvasElement, toggle: HTMLButtonElement | null) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    // A still picture instead of an animation: for reduced motion, for Save-Data,
    // and for devices too slow to animate within the frame budget.
    const saveData = (navigator as { connection?: { saveData?: boolean } }).connection?.saveData === true;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let slow = false;
    const still = () => reduced.matches || saveData || slow;
    // Paused by the visitor, with the button.
    let held = remembered();
    let theme = colours();
    let fluid: LJFluid;
    let generation = 0;
    let settled = false;
    let onScreen = false;
    let running = false;
    let frame = 0;
    let last = 0;
    let substeps = 3;
    let cost = 0; // moving average of one frame's work, in milliseconds
    let measured = 0;

    function setup() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(rect.width * dpr));
      canvas.height = Math.max(1, Math.round(rect.height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const lx = Math.max(rect.width / SIGMA_PX, 3 * CUTOFF);
      const ly = Math.max(rect.height / SIGMA_PX, 3 * CUTOFF);
      const n = Math.min(MAX_PARTICLES, Math.max(24, Math.round(lx * ly * DENSITY)));
      fluid = new LJFluid(lx, ly, n);
    }

    function draw() {
      const { x, y, n } = fluid;
      ctx!.clearRect(0, 0, fluid.lx * SIGMA_PX, fluid.ly * SIGMA_PX);
      ctx!.lineWidth = 1;
      const bond2 = BOND * BOND;
      const sizes = fluid.bonds((i, j, r2) => {
        const a = Math.min(1, (bond2 - r2) / 0.5) * 0.3;
        ctx!.strokeStyle = `rgba(${theme.bond}, ${a})`;
        ctx!.beginPath();
        ctx!.moveTo(x[i] * SIGMA_PX, y[i] * SIGMA_PX);
        ctx!.lineTo(x[j] * SIGMA_PX, y[j] * SIGMA_PX);
        ctx!.stroke();
      });
      // Vapour first, then droplets over it.
      for (const droplet of [false, true]) {
        ctx!.fillStyle = droplet ? `rgba(${theme.bond}, 0.85)` : `rgba(${theme.particle}, 0.6)`;
        ctx!.beginPath();
        for (let i = 0; i < n; i++) {
          if (sizes[i] >= DROPLET !== droplet) continue;
          ctx!.moveTo(x[i] * SIGMA_PX + 1.8, y[i] * SIGMA_PX);
          ctx!.arc(x[i] * SIGMA_PX, y[i] * SIGMA_PX, 1.8, 0, Math.PI * 2);
        }
        ctx!.fill();
      }
    }

    // Keeps each frame within budget: fewer steps per frame first, then a still picture.
    function adapt(ms: number) {
      cost = measured === 0 ? ms : 0.9 * cost + 0.1 * ms;
      if (++measured < 30 || cost <= BUDGET_MS) return;
      if (substeps > 1) substeps--;
      else {
        slow = true;
        pause();
      }
      measured = 0;
    }

    function tick(now: number) {
      if (!running) return;
      frame = requestAnimationFrame(tick);
      if (now - last < FRAME_MS - 1) return;
      last = now;
      const t0 = performance.now();
      fluid.step(substeps);
      draw();
      adapt(performance.now() - t0);
    }

    // The button shows only while there is motion to stop, and says what it does.
    function label() {
      if (!toggle) return;
      toggle.hidden = still();
      toggle.textContent = held ? 'Play animation' : 'Pause animation';
    }

    function play() {
      label();
      if (running || still() || held || !settled || !onScreen || document.hidden) return;
      running = true;
      canvas.dataset.state = 'running';
      frame = requestAnimationFrame(tick);
    }

    function pause() {
      running = false;
      cancelAnimationFrame(frame);
      canvas.dataset.state = still() ? 'still' : held ? 'held' : 'paused';
      label();
    }

    toggle?.addEventListener('click', () => {
      held = !held;
      remember(held);
      held ? pause() : play();
    });
    reduced.addEventListener('change', () => (still() ? pause() : play()));

    // Melts the starting lattice a slice at a time, then shows the fluid.
    function settle() {
      const mine = ++generation;
      settled = false;
      let remaining = SETTLE_STEPS;
      const slice = () => {
        if (mine !== generation) return; // resized since; a newer settle is running
        const end = performance.now() + SLICE_MS;
        while (remaining > 0 && performance.now() < end) {
          fluid.step(1);
          remaining--;
        }
        if (remaining > 0) return void idle(slice);
        settled = true;
        draw();
        canvas.classList.add('ready');
        pause();
        play();
      };
      idle(slice);
    }

    setup();
    settle();

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      onScreen ? play() : pause();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    let width = canvas.clientWidth;
    new ResizeObserver(() => {
      if (canvas.clientWidth === width) return; // height-only changes, e.g. mobile toolbars
      width = canvas.clientWidth;
      pause();
      setup();
      settle();
    }).observe(canvas);
    new MutationObserver(() => {
      theme = colours();
      if (settled) draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    const host = canvas.parentElement ?? canvas;
    host.addEventListener('pointermove', (event) => {
      const rect = canvas.getBoundingClientRect();
      fluid.probe = { x: (event.clientX - rect.left) / SIGMA_PX, y: (event.clientY - rect.top) / SIGMA_PX };
    });
    host.addEventListener('pointerleave', () => (fluid.probe = null));
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas.particle-field')
    .forEach((canvas) => start(canvas, canvas.parentElement?.querySelector('.particle-toggle') ?? null));
</script>

<style>
  .particle-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 70% 35%, #000 25%, transparent 80%);
    mask-image: radial-gradient(ellipse 85% 75% at 70% 35%, #000 25%, transparent 80%);
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .particle-field.ready {
    opacity: 0.9;
  }
  /* Beside the hero's foot, aligned with the page's content column; in the
     flow below the hero's content where the columns stack, so larger text or
     spacing never pushes it under what is above. */
  .particle-note {
    position: absolute;
    inset-inline: 0;
    bottom: 0.9rem;
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .particle-caption {
    max-width: 30rem;
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    text-align: right;
    color: var(--fg-subtle);
  }
  .particle-toggle {
    flex: none;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg-muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .particle-toggle:hover {
    color: var(--fg);
  }
  .particle-toggle[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .particle-note {
      position: relative;
      bottom: auto;
      margin-top: 2.5rem;
      justify-content: space-between;
    }
    .particle-caption {
      text-align: left;
    }
  }
</style>

---
import ParticleField from '../components/ParticleField.astro';
import Base from '../layouts/Base.astro';
import { engine, site } from '../data/site';

// Tells search engines what the name and logo are, for the result card.
const home = Astro.site!.href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${home}#organization`,
      name: site.name,
      url: home,
      logo: new URL('/icon-512.png', home).href,
      email: site.email,
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: site.name,
      url: home,
      publisher: { '@id': `${home}#organization` },
    },
  ],
};

const phases = [
  {
    name: 'Config',
    kind: 'the study',
    text: 'One file: the system, how it is prepared, how it is simulated, what is measured and how it is reported.',
  },
  {
    name: 'setup',
    kind: 'phase',
    text: 'Fetches or reads the structure, repairs what is missing, decides what each non-standard residue is for, then solvates and adds ions.',
  },
  {
    name: 'simulation',
    kind: 'phase',
    text: 'Minimisation, NVT and NPT equilibration, then production. Restraints, membranes and biased sampling when the study asks for them.',
  },
  {
    name: 'analysis',
    kind: 'phase',
    text: 'Each analysis measures its own copy of the trajectory and records the settings it actually used.',
  },
  {
    name: 'report',
    kind: 'phase',
    text: 'A methods paragraph assembled from recorded values, and a convergence section that says what the trajectory can support.',
  },
  {
    name: 'Manifest',
    kind: 'the record',
    text: 'Every phase, artifact and setting, and the software stack it ran on. Readable by someone who was not there.',
  },
];

const studies = [
  {
    title: 'A protein on its own',
    text: 'Fold, flexibility, secondary structure, native contacts and conformational clustering, from a PDB code. Fluctuations can be set against the crystal’s own B-factors.',
  },
  {
    title: 'A protein with a ligand',
    text: 'The ligand is found, its chemistry resolved and its protonation settled in the binding site. Interactions against published criteria show what holds it, not only what it touches.',
  },
  {
    title: 'A membrane protein',
    text: 'Embedded in a lipid bilayer, with its orientation checked rather than assumed and pressure coupling suited to a lipid system.',
  },
  {
    title: 'Free energy along a coordinate',
    text: 'Umbrella sampling, metadynamics and steered MD from a named collective variable. Each result says what it is and what it is not.',
  },
  {
    title: 'A trajectory you already have',
    text: 'Skip the simulation and analyse trajectories written by other engines, in their own formats.',
  },
  {
    title: 'Many systems at once',
    text: 'Mutants against wild type, a sweep across a setting, one run per GPU, and a comparison report across all of them.',
  },
];

const ways = [
  {
    title: 'Describe it',
    text: 'Say what you want in a sentence. The Agent writes the study, and the same validator that checks every study checks it before anything runs.',
  },
  {
    title: 'Build it',
    text: 'A form with every setting visible and explained, checked as you go, for when you know exactly what you want.',
  },
  {
    title: 'Bring it',
    text: 'Upload a Config you already have. It runs as written, and every study can be downloaded as a Config again.',
  },
];

const faq = [
  {
    q: 'Can I use MDXplora today?',
    a: 'MDXplora is in early access. Join the list and we will be in touch as places open, starting with a small number of groups.',
  },
  {
    q: 'Do I need a GPU?',
    a: 'No. Run on GPUs we provide, or connect your own workstation or cluster and choose for each study where it runs.',
  },
  {
    q: 'Where does my data go?',
    a: 'Studies run on our GPUs are stored for your account. Studies run on your own machines can keep their trajectories on your own storage, with only the records and reports shown in MDXplora.',
  },
];
---

<Base>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <section class="hero">
    <ParticleField />
    <div class="container hero-inner">
      <div class="hero-copy">
        <a class="pill" href="/contact/?topic=early-access">
          <span class="dot"></span> Early access is open
        </a>
        <h1>
          From a PDB code to <span class="gradient-text">publishable molecular dynamics</span>
        </h1>
        <p class="support">{site.support}</p>
        <p class="lead">
          MDXplora prepares the system, runs the dynamics, analyses the trajectory and writes the study up, in your
          browser. Where the structure does not say enough, it stops and says why.
        </p>
        <div class="cta">
          <a class="button button-primary" href="/contact/?topic=early-access">
            Join early access
          </a>
          <a class="button button-secondary" href="#how">
            How it works
          </a>
        </div>
      </div>

      <figure class="preview" aria-label="A preview of a study being written in MDXplora">
        <div class="preview-bar">
          <span></span>
          <span></span>
          <span></span>
          <span class="preview-title">New study</span>
        </div>
        <div class="preview-body">
          <p class="bubble">Simulate trypsin with benzamidine bound at pH 6.5 for 100 ns</p>
          <div class="proposal">
            <div class="proposal-head">
              <span>Config</span>
              <span class="valid">Validated</span>
            </div>
            <pre class="code"><code><span class="key">systems</span>:
  - <span class="key">system</span>: <span class="string">3PTB</span>
<span class="key">setup</span>:
  <span class="key">ph</span>: <span class="string">6.5</span>
  <span class="key">forcefield</span>: <span class="string">amber-openff</span>
  <span class="key">ligand_name</span>: <span class="string">BEN</span>
<span class="key">simulation</span>:
  <span class="key">duration_ns</span>: <span class="string">100</span></code></pre>
          </div>
          <div class="run-on">
            <span class="run-label">Run on</span>
            <span class="chip chip-on">MDXplora GPU</span>
            <span class="chip">Your workstation</span>
          </div>
        </div>
        <figcaption>A preview of MDXplora, which is in early access.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How a study runs</span>
        <h2>A Config goes in. A Manifest comes out.</h2>
        <p>
          One file describes the whole study. Four phases run from it, each in its own directory, and one record says
          what actually happened.
        </p>
      </div>
      <ol class="pipeline">
        {phases.map((p, i) => (
          <li class:list={['stage', { edge: p.kind !== 'phase' }]}>
            <span class="stage-index">{String(i).padStart(2, '0')}</span>
            <h3>
              <code>{p.name}</code>
            </h3>
            <span class="stage-kind">{p.kind}</span>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Three ways to start</span>
        <h2>Describe it, build it, or bring it.</h2>
      </div>
      <div class="grid-3">
        {ways.map((w) => (
          <article class="card">
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What you can study</span>
        <h2>From one protein to a campaign.</h2>
      </div>
      <div class="grid-3">
        {studies.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <span class="eyebrow">Scientific integrity</span>
        <h2>It refuses rather than guesses.</h2>
        <p>
          An ambiguous ligand charge, a protein backwards in its membrane, a free-energy surface that never converged:
          each stops the run and is named, not papered over.
        </p>
        <ul class="checks">
          <li>Every refusal carries a sentence for a person and a code for a program.</li>
          <li>Biased averages are corrected to equilibrium where the bias allows, and labelled where it does not.</li>
          <li>A standard error the trajectory cannot support is withheld, not printed beside a caveat.</li>
        </ul>
      </div>
      <div class="refusal" role="img" aria-label="An example of a study that was refused, with the reason">
        <div class="refusal-head">
          <span class="refusal-mark">!</span>
          <span>Setup stopped</span>
        </div>
        <p>
          Ligand BEN: the study states a net charge of +1, and the chemistry file carries formal charges summing to 0.
          The file is the chemistry, so the two cannot both stand.
        </p>
        <p class="refusal-fix">Supply the ligand in the protonation state the study means, then run again.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <span class="eyebrow">Compute</span>
        <h2>Our GPUs, or yours.</h2>
        <p>
          Run on GPUs we provide, or connect your own workstation or cluster in one command. Your machine asks MDXplora
          for work, so nothing reaches into your network.
        </p>
        <a class="text-link" href="/compute/">
          How your own compute connects →
        </a>
      </div>
      <div class="card owned">
        <h3>Your data stays yours</h3>
        <p>Every study can be downloaded whole: the Config, the data, the report and the Manifest.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>When you would rather we ran it.</h2>
        <p>For groups without someone to run molecular dynamics, and for labs that depend on it.</p>
        <a class="text-link" href="/services/">
          Services →
        </a>
      </div>
      <ul class="card offers">
        <li>
          <h3>Studies run for you</h3>
          <p>You get the report, the data and the full record behind them.</p>
        </li>
        <li>
          <h3>Training for your group</h3>
          <p>From a first study to your own campaigns, on your own systems.</p>
        </li>
        <li>
          <h3>Support</h3>
          <p>For your machines, for studies that refuse, and for results that need a second pair of eyes.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container faq">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Before you ask.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
        <details id="cite">
          <summary>How do I cite results?</summary>
          <p>
            Results produced on MDXplora are computed with {engine.name}. Cite its paper (
            <a href={`https://doi.org/${engine.paperDoi}`}>{engine.paperDoi}</a>) and the release named in your study’s
            Manifest (<a href={`https://doi.org/${engine.archiveDoi}`}>{engine.archiveDoi}</a>).
          </p>
        </details>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 9vw, 120px) clamp(72px, 10vw, 128px);
    background:
      radial-gradient(70rem 36rem at 80% -20%, var(--glow), transparent 70%),
      radial-gradient(50rem 30rem at -10% 10%, color-mix(in srgb, var(--teal) 9%, transparent), transparent 70%);
    border-bottom: 1px solid var(--border);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .hero .pill {
    text-decoration: none;
  }
  .hero h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.6rem, 6.2vw, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  .support {
    margin-top: 1.25rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 500;
    color: var(--fg);
  }
  .lead {
    margin-top: 1rem;
    max-width: 36rem;
    font-size: 1.075rem;
    color: var(--fg-muted);
  }
  .cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .preview {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-l);
    background: var(--bg-raised);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .preview-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .preview-bar > span:not(.preview-title) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .preview-title {
    margin-left: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg-subtle);
  }
  .preview-body {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }
  .bubble {
    justify-self: end;
    max-width: 85%;
    padding: 0.7rem 1rem;
    border-radius: 14px 14px 4px 14px;
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .proposal {
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  .proposal-head {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg-muted);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .valid {
    color: var(--teal);
  }
  .valid::before {
    content: '✓ ';
  }
  .proposal .code {
    border: 0;
    border-radius: 0;
    font-size: 0.8rem;
  }
  .run-on {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
  }
  .run-label {
    color: var(--fg-subtle);
    font-weight: 600;
    margin-right: 0.25rem;
  }
  .chip {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg-muted);
  }
  .chip-on {
    border-color: var(--accent);
    color: var(--fg);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .preview figcaption {
    padding: 0.75rem 1.25rem 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }

  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--border);
  }
  .stage {
    position: relative;
    padding: 1.5rem 1.25rem 1.75rem;
    background: var(--surface);
  }
  .stage.edge {
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }
  .stage-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .stage h3 {
    margin-top: 0.9rem;
    font-size: 1.05rem;
  }
  .stage h3 code {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .stage-kind {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .stage p {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .text-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .split .section-head {
    margin-bottom: 0;
  }
  .checks {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    color: var(--fg-muted);
  }
  .checks li {
    position: relative;
    padding-left: 1.75rem;
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--teal) 20%, transparent);
    box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--teal) 70%, transparent);
  }
  .refusal {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, #f2a23a 45%, var(--border));
    border-radius: var(--radius-l);
    background: color-mix(in srgb, #f2a23a 6%, var(--surface));
    box-shadow: var(--shadow);
  }
  .refusal-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
  }
  .refusal-mark {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: #f2a23a;
    color: #1a1204;
    font-weight: 800;
    font-size: 0.85rem;
  }
  .refusal p {
    margin-top: 0.9rem;
    color: var(--fg-muted);
  }
  .refusal .refusal-fix {
    color: var(--fg);
    font-weight: 500;
  }
  .owned h3 {
    font-size: 1.3rem;
  }
  .offers {
    list-style: none;
    margin: 0;
    display: grid;
    gap: 0;
    padding: 0.5rem 1.75rem;
  }
  .offers li {
    padding-block: 1.1rem;
  }
  .offers li + li {
    border-top: 1px solid var(--border);
  }
  .offers p {
    margin-top: 0.3rem;
  }

  .faq {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(32px, 6vw, 72px);
  }
  .faq .section-head {
    margin-bottom: 0;
  }
  .faq-list details {
    border-bottom: 1px solid var(--border);
  }
  .faq-list details:first-child {
    border-top: 1px solid var(--border);
  }
  .faq-list summary {
    padding: 1.15rem 0;
    font-weight: 600;
    font-size: 1.05rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-list summary::after {
    content: '+';
    color: var(--fg-subtle);
    font-weight: 400;
  }
  .faq-list details[open] summary::after {
    content: '−';
  }
  .faq-list p {
    padding-bottom: 1.25rem;
    color: var(--fg-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 1060px) {
    .pipeline {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 900px) {
    .hero-inner,
    .split,
    .faq {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .pipeline {
      grid-template-columns: 1fr;
    }
  }
</style>

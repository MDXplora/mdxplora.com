---
import ParticleField from '../components/ParticleField.astro';
import Base from '../layouts/Base.astro';
import { release, site } from '../data/site';

const phases = [
  {
    name: 'Config',
    kind: 'the study',
    text: 'One file: the system, how it is prepared, how it is simulated, what is measured and how it is reported.',
  },
  {
    name: 'setup',
    kind: 'phase',
    text: 'Fetches or reads the structure, repairs what is missing, decides what each non-standard residue is for, then solvates and adds ions.',
  },
  {
    name: 'simulation',
    kind: 'phase',
    text: 'Minimisation, NVT and NPT equilibration, then production. Restraints, membranes and biased sampling when the study asks for them.',
  },
  {
    name: 'analysis',
    kind: 'phase',
    text: 'Each analysis measures its own copy of the trajectory and records the settings it actually used.',
  },
  {
    name: 'report',
    kind: 'phase',
    text: 'A methods paragraph assembled from recorded values, and a convergence section that says what the trajectory can support.',
  },
  {
    name: 'Manifest',
    kind: 'the record',
    text: 'Every phase, artifact and setting, and the software stack it ran on. Readable by someone who was not there.',
  },
];

const studies = [
  {
    title: 'A protein on its own',
    text: 'Fold, flexibility, secondary structure, native contacts and conformational clustering, from a PDB code. Fluctuations can be set against the crystal’s own B-factors.',
  },
  {
    title: 'A protein with a ligand',
    text: 'The ligand is found, its chemistry resolved and its protonation settled in the binding site. Interactions against published criteria show what holds it, not only what it touches.',
  },
  {
    title: 'A membrane protein',
    text: 'Embedded in a lipid bilayer, with its orientation checked rather than assumed and pressure coupling suited to a lipid system.',
  },
  {
    title: 'Free energy along a coordinate',
    text: 'Umbrella sampling, metadynamics and steered MD from a named collective variable, without writing PLUMED input. Each result says what it is and what it is not.',
  },
  {
    title: 'A trajectory you already have',
    text: 'Skip the simulation and analyse trajectories written by other engines, in their own formats.',
  },
  {
    title: 'Many systems at once',
    text: 'Mutants against wild type, a sweep across a setting, one run per GPU, and a comparison report across all of them.',
  },
];

const ways = [
  {
    id: 'gui',
    label: 'GUI',
    lead: 'A form in a browser, generated from the schema. Every setting visible, explained and checked before you leave the page.',
    code: `<span class="prompt">$ </span>fastmdx gui`,
  },
  {
    id: 'cli',
    label: 'CLI',
    lead: 'The same settings as flags, generated from the same declaration. Or a file, run as it is.',
    code: `<span class="prompt">$ </span>fastmdx explore --config study.yml --output runs/study`,
  },
  {
    id: 'python',
    label: 'Python',
    lead: 'The same settings as a dictionary, for building studies programmatically.',
    code: `<span class="key">from</span> fastmdxplora <span class="key">import</span> FastMDXplora

FastMDXplora(config=<span class="string">"study.yml"</span>).explore()`,
  },
  {
    id: 'agent',
    label: 'Agent',
    lead: 'The FastMDXplora Agent writes a Config from a sentence. What it writes goes through the same validator, with the same refusals, as a Config typed by hand.',
    code: `<span class="prompt">$ </span>fastmdx agent <span class="string">"simulate trypsin with benzamidine bound at pH 6.5 for 100 ns"</span>`,
  },
];
---

<Base>
  <section class="hero">
    <ParticleField />
    <div class="container hero-inner">
      <div class="hero-copy">
        <a class="pill" href={`${release.repository}/releases/tag/${release.tag}`}>
          <span class="dot"></span> FastMDXplora {release.version} is out
        </a>
        <h1>
          From a PDB code to <span class="gradient-text">publishable molecular dynamics</span>
        </h1>
        <p class="support">{site.support}</p>
        <p class="lead">
          Give FastMDXplora a structure or a four-character PDB code. It prepares the system, runs the dynamics,
          analyses the trajectory and writes the study up. Where the structure does not say enough, it stops and says
          why.
        </p>
        <div class="cta">
          <a class="button button-primary" href="/docs/installation/">
            Install FastMDXplora
          </a>
          <a class="button button-secondary" href="/docs/">
            Read the docs
          </a>
        </div>
      </div>

      <figure class="terminal" aria-label="Installing FastMDXplora and running a study">
        <div class="terminal-bar">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <pre class="code"><code><span class="prompt">$ </span>conda create -n fastmdxplora \
    -c conda-forge fastmdxplora
<span class="prompt">$ </span>conda activate fastmdxplora
<span class="prompt">$ </span>fastmdx explore --system 181L

<span class="accent">setup</span>  <span class="muted">→</span>  <span class="accent">simulation</span>  <span class="muted">→</span>  <span class="accent">analysis</span>  <span class="muted">→</span>  <span class="accent">report</span></code></pre>
        <figcaption>
          T4 lysozyme from its PDB code: the benzene in its cavity parameterised, the dynamics run, the residues holding
          the ligand found, and the study written up.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How a study runs</span>
        <h2>A Config goes in. A Manifest comes out.</h2>
        <p>
          One file describes the whole study. Four phases run from it, each in its own directory, and one record says
          what actually happened.
        </p>
      </div>
      <ol class="pipeline">
        {phases.map((p, i) => (
          <li class:list={['stage', { edge: p.kind !== 'phase' }]}>
            <span class="stage-index">{String(i).padStart(2, '0')}</span>
            <h3>
              <code>{p.name}</code>
            </h3>
            <span class="stage-kind">{p.kind}</span>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
      <div class="config-row">
        <div>
          <h3>That is a complete study.</h3>
          <p>
            Everything unnamed takes a documented default, and every run writes <code>resolved_config.yml</code>, so the
            exact study can be run again by anyone holding that one file.
          </p>
          <a class="text-link" href="/docs/config/">
            The FastMDXplora Config →
          </a>
        </div>
        <pre class="code"><code><span class="key">systems</span>:
  - <span class="key">system</span>: <span class="string">181L</span>
<span class="key">simulation</span>:
  <span class="key">duration_ns</span>: <span class="string">100</span></code></pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What you can study</span>
        <h2>From one protein to a campaign.</h2>
      </div>
      <div class="grid-3">
        {studies.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section refuses">
    <div class="container split">
      <div class="section-head">
        <span class="eyebrow">Scientific integrity</span>
        <h2>It refuses rather than guesses.</h2>
        <p>
          An ambiguous ligand charge, a protein backwards in its membrane, a free-energy surface that never converged:
          each stops the run and is named, not papered over.
        </p>
        <ul class="checks">
          <li>Every refusal carries a sentence for a person and a code for a program.</li>
          <li>Biased averages are corrected to equilibrium where the bias allows, and labelled where it does not.</li>
          <li>A standard error the trajectory cannot support is withheld, not printed beside a caveat.</li>
        </ul>
        <a class="text-link" href="/docs/refusals/">
          FastMDXplora refusals →
        </a>
      </div>
      <pre class="code"><code><span class="prompt">$ </span>fastmdx explore --config study.yml
<span class="string">fastmdx: Unknown setup option 'pH' (did you mean 'ph'?).</span>
<span class="string">Valid options: agent, box_shape, …</span>

<span class="comment"># in a program, for box_shape: dodecahedran</span>
refusal.code       <span class="comment"># 'config.option.not_permitted'</span>
refusal.kind       <span class="comment"># 'structural'</span>
refusal.permitted  <span class="comment"># ('cube', 'dodecahedron', 'octahedron')</span></code></pre>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Four ways in</span>
        <h2>Write a Config the way you work.</h2>
        <p>
          The GUI, the CLI and the Python API are generated from one declaration, so none is a subset of another. The
          Agent is reachable through all three.
        </p>
      </div>
      <div class="tabs" data-tabs>
        <div role="tablist" aria-label="Ways to write a Config" class="tablist">
          {ways.map((w, i) => (
            <button
              role="tab"
              id={`tab-${w.id}`}
              aria-controls={`panel-${w.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {w.label}
            </button>
          ))}
        </div>
        {ways.map((w, i) => (
          <div role="tabpanel" id={`panel-${w.id}`} aria-labelledby={`tab-${w.id}`} hidden={i !== 0} class="panel">
            <p>{w.lead}</p>
            <pre class="code"><code set:html={w.code} /></pre>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <span class="eyebrow">Anywhere</span>
        <h2>Design it here. Run it there.</h2>
        <p>
          The Config is the portable unit. Design a study in the GUI on a laptop, then run the same file on a lab
          workstation or a cluster. <code>fastmdx remote</code> reaches those machines with your own
          <code>ssh</code>, installs where you agree to, and brings the results back.
        </p>
        <a class="text-link" href="/docs/remote/">
          Other machines →
        </a>
      </div>
      <pre class="code"><code><span class="prompt">$ </span>fastmdx remote --machine gpu-box
<span class="prompt">$ </span>fastmdx remote send -c study.yml --machine gpu-box
<span class="prompt">$ </span>fastmdx remote status
<span class="prompt">$ </span>fastmdx remote fetch <span class="muted">&lt;job&gt;</span></code></pre>
    </div>
  </section>

  <section class="section open">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Open source</span>
        <h2>Open, installable, citable.</h2>
        <p>FastMDXplora is free to use, read and change. Every release is archived with its own DOI.</p>
      </div>
      <dl class="facts">
        <div>
          <dt>License</dt>
          <dd>{release.software.license}</dd>
        </div>
        <div>
          <dt>Install</dt>
          <dd>conda-forge</dd>
        </div>
        <div>
          <dt>Latest release</dt>
          <dd>
            <a href={`${release.repository}/releases/tag/${release.tag}`}>{release.version}</a>
          </dd>
        </div>
        <div>
          <dt>Archive</dt>
          <dd>
            <a href={`https://doi.org/${release.doi}`}>{release.doi}</a>
          </dd>
        </div>
      </dl>
      <div class="cta">
        <a class="button button-secondary" href={release.repository}>
          View the source
        </a>
        <a class="button button-secondary" href="/cite/">
          How to cite
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">MDXplora</span>
        <h2>When you would rather not run it yourself.</h2>
      </div>
      <div class="grid-2">
        <article class="card offer">
          <span class="pill">
            <span class="dot"></span> Early access
          </span>
          <h3>MDXplora, hosted</h3>
          <p>
            In development: the Agent and the GUI in your browser, with nothing to install, running on GPUs we provide
            or on your own workstation or cluster.
          </p>
          <a class="text-link" href="/hosted/">
            How hosting will work →
          </a>
        </article>
        <article class="card offer">
          <span class="pill">Services</span>
          <h3>Work with us</h3>
          <p>Studies run for you, training for your group, and support for labs that depend on FastMDXplora.</p>
          <a class="text-link" href="/services/">
            Services →
          </a>
        </article>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const move = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!move) return;
        const next = tabs[(i + move + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 9vw, 120px) clamp(72px, 10vw, 128px);
    background:
      radial-gradient(70rem 36rem at 80% -20%, var(--glow), transparent 70%),
      radial-gradient(50rem 30rem at -10% 10%, color-mix(in srgb, var(--teal) 9%, transparent), transparent 70%);
    border-bottom: 1px solid var(--border);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .hero .pill {
    text-decoration: none;
  }
  .hero h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.6rem, 6.2vw, 4.6rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  .support {
    margin-top: 1.25rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 500;
    color: var(--fg);
  }
  .lead {
    margin-top: 1rem;
    max-width: 36rem;
    font-size: 1.075rem;
    color: var(--fg-muted);
  }
  .cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .terminal {
    border: 1px solid #1f2a47;
    border-radius: var(--radius-l);
    background: var(--code-bg);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .terminal-bar {
    display: flex;
    gap: 6px;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid #1a2440;
  }
  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #26314f;
  }
  .terminal .code {
    border: 0;
    border-radius: 0;
    font-size: 0.82rem;
  }
  .terminal figcaption {
    padding: 0.9rem 1.4rem 1.2rem;
    border-top: 1px solid #1a2440;
    color: #8b95b3;
    font-size: 0.85rem;
  }

  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--border);
  }
  .stage {
    position: relative;
    padding: 1.5rem 1.25rem 1.75rem;
    background: var(--surface);
  }
  .stage.edge {
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }
  .stage-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .stage h3 {
    margin-top: 0.9rem;
    font-size: 1.05rem;
  }
  .stage h3 code {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .stage-kind {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .stage p {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .config-row {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .config-row h3 {
    font-size: 1.35rem;
  }
  .config-row p {
    margin-top: 0.75rem;
    color: var(--fg-muted);
  }
  .config-row :not(pre) > code,
  .section-head :not(pre) > code {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--bg-sunken);
    border: 1px solid var(--border);
  }
  .text-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .split .section-head {
    margin-bottom: 0;
  }
  .checks {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    color: var(--fg-muted);
  }
  .checks li {
    position: relative;
    padding-left: 1.75rem;
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--teal) 20%, transparent);
    box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--teal) 70%, transparent);
  }

  .tablist {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
  }
  .tablist button {
    border: 0;
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .tablist button[aria-selected='true'] {
    background: var(--fg);
    color: var(--bg);
  }
  .panel {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem;
    align-items: center;
  }
  .panel[hidden] {
    display: none;
  }
  .panel p {
    font-size: 1.05rem;
    color: var(--fg-muted);
  }

  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
    overflow: hidden;
  }
  .facts div {
    padding: 1.5rem;
  }
  .facts div + div {
    border-left: 1px solid var(--border);
  }
  .facts dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .facts dd {
    margin: 0.5rem 0 0;
    font-size: 1.15rem;
    font-weight: 600;
    word-break: break-word;
  }
  .facts a {
    text-decoration: none;
  }
  .open .cta {
    margin-top: 1.5rem;
  }

  .offer .pill {
    margin-bottom: 1.25rem;
  }
  .offer h3 {
    font-size: 1.4rem;
  }

  @media (max-width: 1060px) {
    .pipeline {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 900px) {
    .hero-inner,
    .split,
    .config-row,
    .panel {
      grid-template-columns: 1fr;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .facts div:nth-child(3) {
      border-left: 0;
    }
    .facts div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 560px) {
    .pipeline,
    .facts {
      grid-template-columns: 1fr;
    }
    .facts div + div {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>

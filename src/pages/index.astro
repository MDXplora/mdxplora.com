---
import Base from '../layouts/Base.astro';
import { engine, site } from '../data/site';

// Tells search engines what the name and logo are, for the result card.
const home = Astro.site!.href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${home}#organization`,
      name: site.name,
      url: home,
      logo: new URL('/icon-512.png', home).href,
      email: site.email,
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: site.name,
      url: home,
      publisher: { '@id': `${home}#organization` },
    },
  ],
};

const phases = [
  {
    name: 'Config',
    kind: 'the study',
    text: 'One file: the system, how it is prepared, how it is simulated, what is analysed and how it is reported.',
  },
  {
    name: 'setup',
    kind: 'phase',
    text: 'Fetches or reads the structure, repairs what is missing, decides what each non-standard residue is for, then solvates and adds ions.',
  },
  {
    name: 'simulation',
    kind: 'phase',
    text: 'Minimisation, NVT and NPT equilibration, then production. Restraints, membranes and biased sampling when the study asks for them.',
  },
  {
    name: 'analysis',
    kind: 'phase',
    text: 'Each analysis works on its own copy of the trajectory and records the settings it actually used.',
  },
  {
    name: 'report',
    kind: 'phase',
    text: 'A methods paragraph assembled from recorded values, and a convergence section that says what the trajectory can support.',
  },
  {
    name: 'Manifest',
    kind: 'the record',
    text: 'Every phase, artifact and setting, and the software stack it ran on. Readable by someone who was not there.',
  },
];

const studies = [
  {
    title: 'A protein on its own',
    text: 'Fold, flexibility, secondary structure, native contacts and conformational clustering, from a PDB code. Fluctuations can be set against the crystal’s own B-factors.',
  },
  {
    title: 'A protein with a ligand',
    text: 'The ligand is found, its chemistry resolved and its protonation determined in the binding site. Interactions against published criteria show what holds it, not only what it touches.',
  },
  {
    title: 'A membrane protein',
    text: 'Embedded in a lipid bilayer, with its orientation checked rather than assumed and pressure coupling suited to a lipid system.',
  },
  {
    title: 'Free energy along a coordinate',
    text: 'Umbrella sampling, metadynamics and steered MD from a named collective variable. Each result says what it is and what it is not.',
  },
  {
    title: 'A trajectory you already have',
    text: 'Skip the simulation and analyse trajectories written by other engines, in their own formats.',
  },
  {
    title: 'Many systems at once',
    text: 'Mutants against wild type, a sweep across a setting, one run per GPU, and a comparison report across all of them.',
  },
];

const ways = [
  {
    title: 'Describe it',
    text: 'Say what you want in a sentence. The Agent writes the study’s Config, and MDXplora validates it, as it does every Config, before anything runs.',
  },
  {
    title: 'Build it',
    text: 'A form that shows and explains every setting and validates each one as you go, for when you know exactly what you want.',
  },
  {
    title: 'Bring it',
    text: 'Upload a Config you already have. It runs as written, and every study can be downloaded as a Config again.',
  },
];

const faq = [
  {
    q: 'Can I use MDXplora today?',
    a: 'MDXplora is being built and opens to early-access groups in stages, a small number first. Ask for a place through the contact form and we will be in touch as places open.',
  },
  {
    q: 'Do I need a GPU?',
    a: 'No. Studies will run on GPUs we provide. Connecting your own workstation or cluster, and choosing for each study where it runs, is planned.',
  },
  {
    q: 'Where does my data go?',
    a: 'Studies will run on our GPUs and will be stored for your account. Once your own machines can be connected, studies run there will be able to keep their trajectories on your own storage, with only the records and reports shown in MDXplora.',
  },
];
---

<Base>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>
          <span class="line">From question to</span> <span class="line">publishable</span>{' '}
          <span class="line">molecular dynamics</span>
        </h1>
        <p class="support">{site.support}</p>
        <p class="lead">
          MDXplora prepares the system, runs the dynamics, analyses the trajectory and writes up the study, in your
          browser.
        </p>
        <p class="planned">{site.status}</p>
        <div class="cta">
          <a class="button button-primary" href="/contact/?topic=early-access">
            Join early access
          </a>
          <a class="button button-secondary" href="#how">
            How it works
          </a>
        </div>
      </div>

      <figure class="preview" aria-label="A preview of a study being written in MDXplora">
        <div class="window">
          <div class="preview-bar">
            <span class="preview-title">New study</span>
          </div>
          <div class="preview-body">
            <p class="request">Simulate trypsin with benzamidine bound at pH 6.5 for 100 ns</p>
            <div class="proposal">
              <div class="proposal-head">
                <span>Config</span>
                <span class="valid">Validated</span>
              </div>
              <pre class="code"><code><span class="key">systems</span>:
  - <span class="key">system</span>: <span class="string">3PTB</span>
<span class="key">setup</span>:
  <span class="key">ph</span>: <span class="string">6.5</span>
  <span class="key">forcefield</span>: <span class="string">amber-openff</span>
  <span class="key">ligand_name</span>: <span class="string">BEN</span>
<span class="key">simulation</span>:
  <span class="key">duration_ns</span>: <span class="string">100</span></code></pre>
            </div>
            <div class="run-on">
              <span class="run-label">Run on</span>
              <span class="chip chip-on">MDXplora GPU</span>
              <span class="chip">Your workstation</span>
            </div>
          </div>
        </div>
        <figcaption>A preview of MDXplora as planned.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <h2>A Config goes in. A Manifest comes out.</h2>
        <p>
          One file describes the whole study. Four phases run from it, each in its own directory, and one record says
          what actually happened.
        </p>
      </div>
      <ol class="pipeline">
        {phases.map((p) => (
          <li class:list={['stage', { edge: p.kind !== 'phase' }]}>
            <h3>
              <code>{p.name}</code>
            </h3>
            <span class="stage-kind">{p.kind}</span>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Describe it, build it, or bring it.</h2>
      </div>
      <div class="grid-3">
        {ways.map((w) => (
          <article class="card">
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>From one protein to a campaign.</h2>
      </div>
      <div class="grid-3">
        {studies.map((s) => (
          <article class="entry">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <h2>It refuses rather than guesses.</h2>
        <p>
          An ambiguous ligand charge, a protein backwards in its membrane, a free-energy surface that never converged:
          each stops the run and is named, not papered over.
        </p>
        <ul class="checks">
          <li>Every refusal carries a sentence for a person and a code for a program.</li>
          <li>Biased averages are corrected to equilibrium where the bias allows, and labelled where it does not.</li>
          <li>A standard error the trajectory cannot support is withheld, not printed beside a caveat.</li>
        </ul>
      </div>
      <figure class="refusal" aria-label="An example of a study that was refused, with the reason">
        <div class="refusal-head">
          <span class="refusal-mark">!</span>
          <span>Setup stopped</span>
        </div>
        <p>
          Ligand BEN: the study states a net charge of +1, and the chemistry file carries formal charges summing to 0.
          The file is the chemistry, so the two cannot both stand.
        </p>
        <p class="refusal-fix">Supply the ligand in the protonation state the study means, then run again.</p>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Our GPUs, or yours.</h2>
        <p>
          Studies will run on GPUs we provide. Connecting your own workstation or cluster is planned: your machine will
          ask MDXplora for work, so nothing reaches into your network.
        </p>
        <a class="text-link" href="/compute/">
          How your own compute will connect
        </a>
      </div>
      <div class="owned">
        <h3>Your data stays yours</h3>
        <p>Every study can be downloaded whole: the Config, the data, the report and the Manifest.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <h2>When you would rather we ran it.</h2>
        <p>For groups without someone to run molecular dynamics, and for labs that depend on it.</p>
        <a class="text-link" href="/services/">
          Services
        </a>
      </div>
      <ul class="offers">
        <li>
          <h3>Studies run for you</h3>
          <p>You get the report, the data and the full record behind them.</p>
        </li>
        <li>
          <h3>Training for your group</h3>
          <p>From a first study to your own campaigns, on your own systems.</p>
        </li>
        <li>
          <h3>Support</h3>
          <p>For your machines, for studies that refuse, and for results that need a second pair of eyes.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container faq">
      <div class="section-head">
        <h2>Before you ask.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
        <details id="cite">
          <summary>How do I cite results?</summary>
          <p>
            Results produced on MDXplora will be computed with {engine.name}. Cite the paper it asks to be cited (
            <a href={`https://doi.org/${engine.paperDoi}`}>{engine.paperDoi}</a>) and the release named in your study’s
            Manifest (<a href={`https://doi.org/${engine.archiveDoi}`}>{engine.archiveDoi}</a>).
          </p>
        </details>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(56px, 8vw, 104px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  /* Three lines where there is room: the question, then what it becomes. The
     size is set so the longest line, "molecular dynamics", fits the column. */
  @media (min-width: 901px) {
    .hero h1 {
      font-size: min(4.4vw, 3.25rem);
    }
    .hero h1 .line {
      display: block;
      white-space: nowrap;
    }
  }
  .support {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .lead {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }
  .cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* The preview is drawn as the platform's own interface is, in its dark scheme whichever theme the page is in: its
     greys, its type and a thin edge, with blue only for the machine the study will run on. */
  .window {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-m);
    background: #1c1c1d;
    color: #ececee;
    overflow: hidden;
    font-size: 0.875rem;
  }
  .preview-bar {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: #171718;
  }
  .preview-title {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #b4b6ba;
  }
  .preview-body {
    display: grid;
    gap: 0.875rem;
    padding: 1rem;
  }
  .request {
    justify-self: end;
    max-width: 85%;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-s);
    background: #2a2d31;
    color: #ececee;
  }
  .proposal {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-s);
    overflow: hidden;
  }
  .proposal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #ececee;
    background: #212529;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .valid {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #67e8a3;
  }
  .valid::before,
  .chip-on::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .proposal .code {
    border: 0;
    border-radius: 0;
  }
  .run-on {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }
  .run-label {
    margin-right: 0.25rem;
    color: #9a9ca1;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-s);
    color: #b4b6ba;
  }
  .chip-on {
    border-color: #4c9aff;
    color: #ececee;
  }
  .chip-on::before {
    background: #4c9aff;
  }
  .preview figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--fg-subtle);
  }

  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--border);
  }
  .stage {
    padding: 1.25rem 1.125rem 1.5rem;
    background: var(--bg);
  }
  .stage.edge {
    background: var(--surface);
  }
  .stage h3 code {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .stage-kind {
    display: block;
    font-size: 0.8125rem;
    color: var(--fg-subtle);
  }
  .stage p {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .split .section-head {
    margin-bottom: 0;
  }
  .checks {
    margin: 1.5rem 0 0;
    padding-left: 1.125rem;
    display: grid;
    gap: 0.5rem;
    color: var(--fg-muted);
  }
  .checks li::marker {
    color: var(--fg-subtle);
  }
  /* A stopped run, in the software's amber: the edge and the mark, the words in the text's colours. */
  .refusal {
    margin: 0;
    padding: 1.25rem 1.375rem;
    border: 1px solid var(--warning);
    border-radius: var(--radius-m);
    background: var(--surface);
  }
  .refusal-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
  }
  .refusal-mark {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--warning);
    color: var(--bg);
    font-weight: 700;
    font-size: 0.75rem;
  }
  .refusal p {
    margin-top: 0.75rem;
    color: var(--fg-muted);
  }
  .refusal .refusal-fix {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    color: var(--fg);
  }
  /* Under the text it belongs to, as wide as it. */
  .owned {
    max-width: 40rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .owned p {
    margin-top: 0.5rem;
    color: var(--fg-muted);
  }
  .offers {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .offers li {
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--border);
  }
  .offers p {
    margin-top: 0.25rem;
    color: var(--fg-muted);
  }

  .faq {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(32px, 6vw, 72px);
  }
  .faq .section-head {
    margin-bottom: 0;
  }
  .faq-list details {
    border-bottom: 1px solid var(--border);
  }
  .faq-list details:first-child {
    border-top: 1px solid var(--border);
  }
  .faq-list summary {
    padding: 1.125rem 0;
    font-weight: 500;
    font-size: 1.0625rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-list summary::after {
    content: '+';
    color: var(--fg-subtle);
    font-weight: 400;
  }
  .faq-list details[open] summary::after {
    content: '\2212';
  }
  .faq-list p {
    max-width: 40rem;
    padding-bottom: 1.25rem;
    color: var(--fg-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 1060px) {
    .pipeline {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 900px) {
    .hero-inner,
    .split,
    .faq {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .pipeline {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

if (import.meta.env.PROD && !site.formspreeId) {
  throw new Error('PUBLIC_FORMSPREE_ID is not set, so the contact form would have nowhere to send. See README.');
}
// A Formspree form ID is a short run of letters and digits. Anything else, or
// a leftover placeholder such as YOUR_FORM_ID, would publish a form that fails.
if (
  import.meta.env.PROD &&
  (!/^[A-Za-z0-9]{4,32}$/.test(site.formspreeId ?? '') || /your|form|placeholder/i.test(site.formspreeId ?? ''))
) {
  throw new Error(
    `PUBLIC_FORMSPREE_ID is "${site.formspreeId}", which is not a Formspree form ID. Set the ID from the form's page. See README.`,
  );
}

// Each topic gives the email we receive its own subject line, so the inbox sorts itself.
const topics = [
  { value: 'early-access', label: 'Early access to MDXplora', subject: 'Early access request' },
  { value: 'study', label: 'A study run for us', subject: 'Study enquiry' },
  { value: 'training', label: 'Training for our group', subject: 'Training enquiry' },
  { value: 'support', label: 'Support', subject: 'Support request' },
  { value: 'other', label: 'Something else', subject: 'Message' },
];
// Optional questions for early access, to help decide who to bring in first. The field
// names are the questions, so the email we receive reads plainly.
const groups = ['An academic research group', 'A company', 'Teaching a course', 'Something else'];
const compute = [
  'None yet',
  'A workstation with a GPU',
  'A cluster (university, national or company)',
  'Cloud GPUs',
  'Not sure',
];
const subjectPrefix = `${site.name} website`;
const endpoint = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : '';
---

<Base title="Contact" description="Talk to MDXplora about early access, a study, training or support.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Talk to us.</h1>
      <p class="lead">Early access, a study you need run, training for your group, or support. We read everything.</p>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <form class="card form" method="POST" action={endpoint} data-endpoint={endpoint}>
        <div class="row">
          <label>
            <span>Name</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          <span>
            Organisation <em>optional</em>
          </span>
          <input name="organisation" autocomplete="organization" />
        </label>
        <label>
          <span>What is it about?</span>
          <select name="topic" required>
            {topics.map((t) => (
              <option value={t.value} data-subject={t.subject}>
                {t.label}
              </option>
            ))}
          </select>
        </label>
        <fieldset class="early" id="early-access">
          <legend>
            About your work <em>optional</em>
          </legend>
          <p class="hint">
            For early access. These help us decide who to bring in first. If we can offer you a place, we will set out
            the terms before anything starts.
          </p>
          <div class="row">
            <label>
              <span>Where you work</span>
              <select name="where you work">
                <option value="">Choose one</option>
                {groups.map((g) => (
                  <option>{g}</option>
                ))}
              </select>
            </label>
            <label>
              <span>Compute you have now</span>
              <select name="compute you have now">
                <option value="">Choose one</option>
                {compute.map((c) => (
                  <option>{c}</option>
                ))}
              </select>
            </label>
          </div>
          <label>
            <span>What you want to simulate</span>
            <textarea name="what you want to simulate" rows="3" aria-describedby="systems-hint"></textarea>
            <small id="systems-hint">The system, roughly how many atoms, and the question you want answered.</small>
          </label>
        </fieldset>
        <label>
          <span>Message</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <!-- The email's subject line; set from the topic and name when the form is sent. -->
        <input type="hidden" name="_subject" value={`${subjectPrefix}: message`} data-prefix={subjectPrefix} />
        <!-- Left empty by people; filled by bots. -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true" />
        <div class="submit">
          <button class="button button-primary" type="submit" disabled={!endpoint}>
            Send
          </button>
          <p class="status" role="status" aria-live="polite" tabindex="-1">
            {!endpoint && 'The form is not connected in this build. Please email us instead.'}
          </p>
        </div>
        <p class="fine">
          Sent through Formspree and read only by us, to reply to you. See <a href="/privacy/">Privacy</a>.
        </p>
      </form>

      <aside class="direct">
        <h2>Prefer email?</h2>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <h2>What happens next</h2>
        <p>We read every message and reply by email. Asking about early access commits you to nothing.</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form.form');
  const status = form?.querySelector<HTMLElement>('.status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const topic = new URLSearchParams(location.search).get('topic');
  const select = form?.querySelector<HTMLSelectElement>('select[name="topic"]');
  if (topic && select && Array.from(select.options).some((o) => o.value === topic)) select.value = topic;

  // The early-access questions show only for that topic. A disabled fieldset is not sent.
  const early = form?.querySelector<HTMLFieldSetElement>('#early-access');
  const showEarly = () => {
    if (!early || !select) return;
    const on = select.value === 'early-access';
    early.hidden = !on;
    early.disabled = !on;
  };
  select?.addEventListener('change', showEarly);
  showEarly();

  // With JavaScript the form checks itself and says what is missing here;
  // without it, the browser does, and the form is posted as it is.
  if (form) form.noValidate = true;

  // Emptied first, so the same words said twice are announced twice.
  const say = (text: string) => {
    if (!status) return;
    status.textContent = '';
    requestAnimationFrame(() => (status.textContent = text));
  };

  const fields = form ? Array.from(form.querySelectorAll<HTMLInputElement>('input, select, textarea')) : [];
  for (const field of fields) {
    field.addEventListener('input', () => field.validity.valid && field.removeAttribute('aria-invalid'));
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.dataset.endpoint || !status || !button) return;
    if (!form.checkValidity()) {
      for (const field of fields) {
        if (field.willValidate && !field.validity.valid) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      }
      say('Please fill in your name, a valid email address and a message.');
      form.reportValidity();
      return;
    }
    const subject = form.querySelector<HTMLInputElement>('input[name="_subject"]');
    const chosen = select?.selectedOptions[0]?.dataset.subject;
    const name = (form.querySelector<HTMLInputElement>('input[name="name"]')?.value ?? '')
      .replace(/\s+/g, ' ')
      .trim()
      .slice(0, 80);
    if (subject && chosen) subject.value = `${subject.dataset.prefix}: ${chosen} from ${name}`;
    button.disabled = true;
    say('Sending…');
    try {
      const response = await fetch(form.dataset.endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      showEarly();
      say('Thank you. Your message has arrived, and we will reply by email.');
    } catch {
      say('That did not go through. Please try again, or email us directly.');
    } finally {
      button.disabled = false;
      // Disabling the button took the focus from it; it goes to what happened.
      status.focus();
    }
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .form {
    display: grid;
    gap: 1.25rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  label {
    display: grid;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  label em {
    font-style: normal;
    font-weight: 400;
    color: var(--fg-subtle);
  }
  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--field-border);
    border-radius: var(--radius-s);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-weight: 400;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }
  textarea {
    resize: vertical;
  }
  fieldset {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    min-inline-size: 0;
  }
  fieldset[hidden] {
    display: none;
  }
  legend {
    padding-inline: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  legend em {
    font-style: normal;
    font-weight: 400;
    color: var(--fg-subtle);
  }
  .hint,
  small {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--fg-muted);
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .submit {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .submit button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  .status {
    color: var(--fg-muted);
    font-size: 0.925rem;
  }
  .status:focus {
    outline: none;
  }
  [aria-invalid='true'] {
    border-color: var(--danger);
  }
  .fine {
    font-size: 0.825rem;
    color: var(--fg-subtle);
  }
  .direct h2 {
    font-size: 1.1rem;
    letter-spacing: -0.015em;
  }
  .direct h2 + p {
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    color: var(--fg-muted);
  }
  @media (max-width: 800px) {
    .layout,
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
